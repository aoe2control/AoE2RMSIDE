{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/renderer/*"]
    },
    "target": "ES2024",
    "types": ["node", "vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src", "vite.config.ts", "vite.*.config.ts"]
}
