{
  "schemaVersion": "1.0.0",
  "compatibility": { "minimumMajor": 1, "maximumMajor": 1 },
  "limits": {
    "frameBytes": 4194304,
    "argumentsJsonBytes": 524288,
    "textItemBytes": 65536,
    "pngBytes": 1572864,
    "imageMaxSide": 1024,
    "imageMinLongSide": 256,
    "connections": 4,
    "callsInFlight": 4,
    "callsPerMinute": 120,
    "picturesPerMinute": 30,
    "handshakeSeconds": 5,
    "pairingWaitSeconds": 3,
    "busyWaitSeconds": 3,
    "defaultWaitSeconds": 50,
    "maxWaitSeconds": 110,
    "promptAnswerSeconds": 110,
    "progressPerSecond": 2,
    "stdinLineBytes": 1048576,
    "qualityCheckMaps": 1600
  },
  "errorCodes": [
    "ide_not_running",
    "version_mismatch",
    "not_approved_yet",
    "not_allowed",
    "invalid_arguments",
    "no_folder_open",
    "outside_workspace",
    "file_type_not_allowed",
    "not_found",
    "already_exists",
    "too_large",
    "binary_file",
    "edit_conflict",
    "saving_off",
    "busy",
    "map_expired",
    "run_expired",
    "stopped",
    "cancelled",
    "user_declined",
    "needs_user_at_pc",
    "blocked_known_crash",
    "game_not_ready",
    "rate_limited",
    "too_many_calls",
    "internal"
  ],
  "qualityCases": [
    "generation",
    "start-resources",
    "resource-distances",
    "shared-resources",
    "wood",
    "trapped",
    "paths",
    "building-space",
    "hills",
    "water",
    "spacing",
    "chokepoints",
    "variation",
    "looks"
  ],
  "tools": [
    {
      "name": "ide_status",
      "title": "IDE status",
      "description": "The open folder, open tabs (unsaved, edited by you), the current Run settings, whether the IDE is busy, the selected quality-check cases, and which game actions are available. Call it first to orient yourself.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false },
      "output": {
        "maxChars": 1500,
        "image": false,
        "shape": "{folder,active,open:[{path,unsaved,app_edits}] (at most 12, then more),run:{version,map_size,players,teams,seed,mode},lane:{state},saving,quality_cases:[id],game_folder,live_test}"
      }
    },
    {
      "name": "list_files",
      "title": "List files",
      "description": "List script files in the open folder or one of its subfolders: RMS scripts, includes, XS, map tests, and text. Sorted by path and paged with cursor.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "dir": {
            "type": "string",
            "description": "Subfolder relative to the open folder; the folder itself when omitted.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "pattern": {
            "type": "string",
            "description": "Glob filter on the file name, for example *.rms.",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\\\:\"<>|\\u0000-\\u001f]+$"
          },
          "cursor": {
            "type": "string",
            "description": "The cursor from the previous page's more.",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 100 }
        },
        "additionalProperties": false
      },
      "output": {
        "maxChars": 4000,
        "image": false,
        "shape": "{dir,files:[{p,kb,unsaved}],dirs:[path],more}"
      }
    },
    {
      "name": "read_file",
      "title": "Read file",
      "description": "Read a file in the open folder. An open tab is read with its unsaved text. Returns a version token for edit_file's base_version. Pages of up to 800 lines.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to the open folder.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "start_line": { "type": "integer", "minimum": 1, "maximum": 1048576, "default": 1 },
          "lines": { "type": "integer", "minimum": 1, "maximum": 800, "default": 400 },
          "numbers": {
            "type": "boolean",
            "description": "Prefix each line with its number; costs tokens.",
            "default": false
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "output": {
        "maxChars": 24000,
        "image": false,
        "shape": "{path,version,lines:'1-400',total_lines,unsaved,text,more}"
      }
    },
    {
      "name": "edit_file",
      "title": "Edit file",
      "description": "Replace text in a file: copy each old_text literally from the file; it must occur once, or set all. All edits apply as one undoable step in the user's editor and stay unsaved. Returns the new version and the file's first errors.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to the open folder.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "old_text": { "type": "string", "minLength": 1, "maxLength": 20000 },
                "new_text": { "type": "string", "minLength": 0, "maxLength": 100000 },
                "all": {
                  "type": "boolean",
                  "description": "Replace every occurrence (at most 200).",
                  "default": false
                }
              },
              "required": ["old_text", "new_text"],
              "additionalProperties": false
            }
          },
          "base_version": {
            "type": "string",
            "description": "The version from read_file; the edit fails if the file changed since.",
            "minLength": 2,
            "maxLength": 65,
            "pattern": "^(v[0-9]{1,16}|d[0-9a-f]{8,64})$"
          },
          "reason": {
            "type": "string",
            "description": "Why, in a few words; shown to the user on the tab.",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": ["path", "edits"],
        "additionalProperties": false
      },
      "output": {
        "maxChars": 2000,
        "image": false,
        "shape": "{path,version,changed,problems:{errors,warnings,first:[{line,code,msg}]}|'pending'}; edit_conflict lists up to 3 nearest lines"
      }
    },
    {
      "name": "create_file",
      "title": "Create file",
      "description": "Create a new file in the open folder with this content. It opens in a background tab with the content unsaved; the user saves it, or you call save_file when saving is allowed.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "New file path relative to the open folder.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "content": { "type": "string", "minLength": 0, "maxLength": 524288 },
          "open": { "type": "boolean", "default": true }
        },
        "required": ["path", "content"],
        "additionalProperties": false
      },
      "output": {
        "maxChars": 2000,
        "image": false,
        "shape": "{path,version,problems:{errors,warnings,first:[{line,code,msg}]}|'pending'}"
      }
    },
    {
      "name": "save_file",
      "title": "Save file",
      "description": "Save a file's tab. Works only when the user turned on Let AI apps save files; otherwise ask the user to save.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "setting",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to the open folder.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "output": { "maxChars": 2000, "image": false, "shape": "{path,saved}" }
    },
    {
      "name": "get_problems",
      "title": "Problems",
      "description": "Errors and warnings of a file as the Problems panel shows them, with fix hints. Info notes are only counted.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to the open folder.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "severity": {
            "type": "string",
            "description": "errors: errors only; warnings: errors and warnings; all: also info.",
            "enum": ["errors", "warnings", "all"],
            "default": "warnings"
          },
          "code": {
            "type": "string",
            "description": "Only problems with this code, for example RMS2042.",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z][A-Za-z0-9-]{0,31}$"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }
        },
        "required": ["path"],
        "additionalProperties": false
      },
      "output": {
        "maxChars": 4000,
        "image": false,
        "shape": "{path,version,counts:{errors,warnings,info},items:[{sev,code,line,col,msg,fix}],includes:[{path,errors}],xs:{errors,note},more}"
      }
    },
    {
      "name": "generate_map",
      "title": "Generate map",
      "description": "Generate a map from the script's current, unsaved text; the IDE shows it in its preview. Returns a compact summary: players and starts, start objects per player, neutral resources, terrain shares, warnings. Settings given here apply to this run only. compare_to adds a one-line difference to an earlier map.",
      "servedBy": "ide",
      "lane": "always",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Script path relative to the open folder; the active script tab when omitted.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "seed": {
            "type": "integer",
            "description": "The game's seed; negative values are the game's signed form.",
            "minimum": -2147483648,
            "maximum": 4294967295
          },
          "settings": {
            "type": "object",
            "description": "Lobby settings for this run only; the user's Run settings fill the rest.",
            "properties": {
              "map_size": {
                "type": "string",
                "description": "tiny, small, medium, normal, large, huge, ludicrous, or a size in tiles.",
                "minLength": 2,
                "maxLength": 9,
                "pattern": "^(tiny|small|medium|normal|large|huge|ludicrous|[1-9][0-9]{1,2})$"
              },
              "players": { "type": "integer", "minimum": 1, "maximum": 8 },
              "teams": {
                "type": "string",
                "description": "ffa or team sizes such as 1v1, 2v2, 4v4, 2v2v2v2.",
                "minLength": 3,
                "maxLength": 15,
                "pattern": "^(ffa|[1-8](v[1-8]){1,7})$"
              },
              "civs": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "game_mode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "age": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "resources": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            },
            "additionalProperties": false
          },
          "from_run": {
            "type": "object",
            "description": "Regenerate a seed and setting of a map test or quality check.",
            "properties": {
              "run": {
                "type": "string",
                "minLength": 2,
                "maxLength": 7,
                "pattern": "^[qr][1-9][0-9]{0,5}$"
              },
              "seed": { "type": "integer", "minimum": -2147483648, "maximum": 4294967295 },
              "setting": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "pattern": "^s[1-8]$"
              }
            },
            "required": ["run", "seed"],
            "additionalProperties": false
          },
          "compare_to": {
            "type": "string",
            "description": "An earlier map id, for example m3.",
            "minLength": 2,
            "maxLength": 9,
            "pattern": "^(m[1-9][0-9]{0,5}|s[1-9][0-9]{0,5}\\.[1-9])$"
          },
          "wait_seconds": { "type": "integer", "minimum": 1, "maximum": 110, "default": 50 }
        },
        "additionalProperties": false
      },
      "output": {
        "maxChars": 3000,
        "image": false,
        "shape": "{map,path,seed,settings,status:'ok'|'failed'|'running',time_s,players:[{p,team,start:[x,y]}],start_objects:{same,differs:[{what,per_player,note}]},neutral,terrain,warnings:[{code,msg}],warning_count,xs,known_crash,compare,more}; failed lists the first 5 errors with lines; running gives {status,run,progress}"
      }
    },
    {
      "name": "show_map",
      "title": "Show map",
      "description": "Show the user a map in the IDE's preview, as the user's own Run does. Without seed and settings it uses the user's Run settings; given ones are set in the Run menu and named in Output. Opens the preview when it is closed; the IDE window does not come to the front.",
      "servedBy": "ide",
      "lane": "always",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Script path relative to the open folder; the active script tab when omitted.",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|\\u0000-\\u001f][^:*?\"<>|\\u0000-\\u001f]*$"
          },
          "seed": {
            "type": "integer",
            "description": "The game's seed; negative values are the game's signed form.",
            "minimum": -2147483648,
            "maximum": 4294967295
          },
          "settings": {
            "type": "object",
            "description": "Lobby settings to set in the user's Run menu; the user's Run settings fill the rest.",
            "properties": {
              "map_size": {
                "type": "string",
                "description": "tiny, small, medium, normal, large, huge, ludicrous, or a size in tiles.",
                "minLength": 2,
                "maxLength": 9,
                "pattern": "^(tiny|small|medium|normal|large|huge|ludicrous|[1-9][0-9]{1,2})$"
              },
              "players": { "type": "integer", "minimum": 1, "maximum": 8 },
              "teams": {
                "type": "string",
                "description": "ffa or team sizes such as 1v1, 2v2, 4v4, 2v2v2v2.",
                "minLength": 3,
                "maxLength": 15,
                "pattern": "^(ffa|[1-8](v[1-8]){1,7})$"
              },
              "civs": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "game_mode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "age": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              },
              "resources": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            },
            "additionalProperties": false
          },
          "wait_seconds": { "type": "integer", "minimum": 1, "maximum": 110, "default": 50 }
        },
        "additionalProperties": false
      },
      "output": {
        "maxChars": 1000,
        "image": false,
        "shape": "{map,shown,seed,settings,status:'ok'|'failed'|'running',warnings,known_crash,changed_run_settings:[name],more}; failed lists the first 5 errors with lines; running gives {status,run,progress}"
      }
    },
    {
      "name": "inspect_map",
      "title": "Inspect map",
      "description": "Terrain and objects in an area of a generated map, or around a player's start. sources: true groups objects by the script line that created them.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "description": "A map id, for example m4.",
            "minLength": 2,
            "maxLength": 9,
            "pattern": "^(m[1-9][0-9]{0,5}|s[1-9][0-9]{0,5}\\.[1-9])$"
          },
          "area": {
            "type": "object",
            "description": "A tile rectangle; x and y are 0-based.",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 479 },
              "y": { "type": "integer", "minimum": 0, "maximum": 479 },
              "w": { "type": "integer", "minimum": 1, "maximum": 480 },
              "h": { "type": "integer", "minimum": 1, "maximum": 480 }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          },
          "player": {
            "type": "integer",
            "description": "Look around this player's start instead of an area.",
            "minimum": 1,
            "maximum": 8
          },
          "radius": { "type": "integer", "minimum": 1, "maximum": 60, "default": 20 },
          "what": {
            "type": "string",
            "enum": ["objects", "terrain", "both"],
            "default": "both"
          },
          "objects": {
            "type": "array",
            "description": "Only these objects: kinds such as gold, stone, relic, or object names and constants.",
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9_ ()-]+$"
            }
          },
          "list": {
            "type": "boolean",
            "description": "List single objects with positions.",
            "default": false
          },
          "sources": {
            "type": "boolean",
            "description": "Group objects by the script line that created them.",
            "default": false
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 40 }
        },
        "required": ["map"],
        "additionalProperties": false
      },
      "output": {
        "maxChars": 5000,
        "image": false,
        "shape": "{map,area,tiles,terrain,elevation,cliffs,objects:[{name,n,nearest}],by_source:[{file,line,cmd,n}],list:[{name,at:[x,y],d}],more}"
      }
    },
    {
      "name": "get_picture",
      "title": "Get picture",
      "description": "A picture of a generated map: the whole map, an area, one player's base, all bases at one scale, two maps side by side, or the IDE preview as the user sees it. A square grid with tile ticks by default. Look preview shows the preview's terrain textures when the IDE has them, so blending can be judged; the other looks average colours.",
      "servedBy": "ide",
      "lane": "none",
      "confirmation": "none",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "map": {
            "type": "string",
            "description": "A map id; your latest map when omitted.",
            "minLength": 2,
            "maxLength": 9,
            "pattern": "^(m[1-9][0-9]{0,5}|s[1-9][0-9]{0,5}\\.[1-9])$"
          },
          "view": {
            "type": "string",
            "description": "whole map, a tile area, one player's base, every base at one scale, a side-by-side comparison, or as_shown: the IDE preview's map, look and framing.",
            "enum": ["whole", "area", "base", "bases", "compare", "as_shown"]
          },
          "area": {
            "type": "object",
            "properties": {
              "x": { "type": "integer", "minimum": 0, "maximum": 479 },
              "y": { "type": "integer", "minimum": 0, "maximum": 479 },
              "w": { "type": "integer", "minimum": 1, "maximum": 480 },
              "h": { "type": "integer", "minimum": 1, "maximum": 480 }
            },
            "required": ["x", "y", "w", "h"],
            "additionalProperties": false
          },
          "player": { "type": "integer", "minimum": 1, "maximum": 8 },
          "radius": { "type": "integer", "minimum": 8, "maximum": 60, "default": 20 },
          "compare_to": {
            "type": "string",
            "description": "For view compare: the other map id.",
            "minLength": 2,
            "maxLength": 9,
            "pattern": "^(m[1-9][0-9]{0,5}|s[1-9][0-9]{0,5}\\.[1-9])$"
          },
          "look": {
