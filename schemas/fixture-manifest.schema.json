{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rmside.invalid/schemas/fixture-manifest/v1",
  "title": "Fixture and visual provenance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "compatibility", "manifestId", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "compatibility": { "$ref": "#/definitions/compatibility" },
    "manifestId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "authorship",
          "license",
          "sourceClassification",
          "created",
          "containsGameContent"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![/\\\\])(?!.*\\.\\.).+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "authorship": { "type": "string", "minLength": 1, "maxLength": 512 },
          "license": { "type": "string", "minLength": 1, "maxLength": 128 },
          "sourceClassification": {
            "enum": ["independent", "generated-independent", "sanitized-observation"]
          },
          "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "containsGameContent": { "const": false },
          "transformation": { "type": "string", "maxLength": 1024 },
          "reviewer": { "type": "string", "maxLength": 128 }
        }
      }
    }
  },
  "definitions": {
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumMajor", "maximumMajor"],
      "properties": {
        "minimumMajor": { "const": 1 },
        "maximumMajor": { "const": 1 }
      }
    }
  }
}
