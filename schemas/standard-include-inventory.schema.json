{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rmside.invalid/schemas/standard-includes/v1",
  "title": "Versioned names-only standard game include inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "compatibility",
    "build",
    "standardIncludes",
    "reservedFileNames"
  ],
  "properties": {
    "$schema": { "const": "https://rmside.invalid/schemas/standard-includes/v1" },
    "schemaVersion": { "const": "1.0.0" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumMajor", "maximumMajor"],
      "properties": {
        "minimumMajor": { "const": 1 },
        "maximumMajor": { "const": 1 }
      }
    },
    "build": { "type": "string", "minLength": 1, "maxLength": 64 },
    "standardIncludes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^(?!.*\\.\\.)(?:includes/)?[A-Za-z0-9_.-]+\\.inc$"
      }
    },
    "reservedFileNames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 513,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^(?!.*\\.\\.)[a-z0-9_.-]+\\.(?:inc|def)$"
      }
    }
  }
}
